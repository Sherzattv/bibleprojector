{
  // Bible Projector v3 — статическая Svelte PWA без серверного кода.
  // Публикуется только production-сборка v3, а не корень репозитория.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bibleprojector",
  "compatibility_date": "2026-07-25",
  "build": {
    // Работает при локальном `npm run deploy`. В Cloudflare Workers Builds
    // команда `npm run build` также должна быть задана в настройках Build.
    "command": "npm run build"
  },
  "assets": {
    "directory": "./v3/dist",
    // Vite создаёт корневой index.html; неизвестные клиентские маршруты
    // возвращаются в приложение.
    "html_handling": "none",
    "not_found_handling": "single-page-application"
  }
}
